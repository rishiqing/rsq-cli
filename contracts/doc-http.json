      "auth": "token",
      "methods": [
        "password",
        "wecom"
      ],
      "command": "doc transport folder-create",
      "description": "在已核对归属和 createNoteBook 权限的普通文集中创建目录；固定 isNoteBook=true，与普通文档/草稿共享 HTTP 接口但保留独立业务上下文。",
      "review": "inferred",
      "defaults": {
        "body": {
          "isNoteBook": true
        }
      },
      "inputSchema": {
        "type": "object",
        "properties": {
          "body": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "\\S"
              },
              "isNoteBook": {
                "const": true
              },
              "corpusId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              },
              "noteBookId": {
                "type": "string",
                "pattern": "^[1-9][0-9]*$"
              }
            },
            "required": [
              "name",
              "isNoteBook"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "body"
        ],
        "additionalProperties": false
      },
      "responseSchema": {
        "type": "object",
        "properties": {
          "id": {
            "type": [
              "integer",
              "string"
            ]
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "corpusId": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "noteBookId": {
            "type": [
              "integer",
              "string",
              "null"
            ]
          },
          "isNoteBook": {
            "type": "boolean"
          },
          "creator": {
            "type": "object"
          },
          "editControl": {
            "type": "object"
          }
        },
        "required": [
          "id"
        ],
        "additionalProperties": true
      },
      "effect": "write",
